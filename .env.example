# 공공데이터포털 일반 인증키(Decoding). 실제 키는 .env에만 입력하세요.
MFDS_SERVICE_KEY=
# 사진을 Studio로 분석할 때만 필요합니다.
UPSTAGE_API_KEY=
UPSTAGE_AGENT_ID=agt_ZFvwgYPuoG7ppQanNZhNqL
# 현재 공식 명세에서 확인한 버전. API 개편 시 명세와 함께 수정하세요.
MFDS_BASE_URL=https://apis.data.go.kr/1471000/DrugPrdtPrmsnInfoService08
PORT=8767

# 비어 있으면 최신 버전, 설정 번호가 있으면 해당 버전 고정
UPSTAGE_CONFIG_ID=

# (선택) 아래 두 API도 같은 공공데이터포털 키로 각각 '활용신청'해야 합니다. 비우면 기본 주소를 씁니다.
# 의약품 성분별 1일 최대투여량 정보 (data.go.kr 15098095)
DAYMAX_BASE_URL=
# 의약품안전사용서비스(DUR) 품목정보 (data.go.kr 15059486)
DUR_BASE_URL=
